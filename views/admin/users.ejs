<%- include('../layouts/_header') %>
<div class="d-flex">
  <%- include('../layouts/_sidebar') %>
  <div class="main-content flex-grow-1">
    <div class="p-4">
      <%- include('../layouts/_alert') %>
      
      <div class="mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0 fw-bold">User Management</h2>
        <span class="badge bg-primary fs-6"><%= locals.users ? locals.users.length : 0 %> Total Users</span>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-0 table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="px-4">Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Created Date</th>
                <th class="text-end px-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.users && locals.users.length > 0) { %>
                <% locals.users.forEach(u => { %>
                  <% const isSelf = locals.user && locals.user.id === u._id.toString(); %>
                  <tr class="<%= isSelf ? 'table-light' : '' %>">
                    <td class="px-4 fw-medium">
                      <%= u.name %>
                      <% if (isSelf) { %>
                        <span class="badge bg-secondary ms-2 small">You</span>
                      <% } %>
                    </td>
                    <td class="text-muted"><%= u.email %></td>
                    <td>
                      <span class="badge badge-<%= u.role %> text-uppercase"><%= u.role %></span>
                    </td>
                    <td class="text-muted small"><%= u.createdAt.toLocaleDateString() %></td>
                    <td class="text-end px-4">
                      <div class="d-flex justify-content-end gap-2 align-items-center">
                        <form action="/admin/users/<%= u._id %>/role?_method=PUT" method="POST" class="d-flex align-items-center gap-2">
                          <select name="role" class="form-select form-select-sm" style="width: auto;" <%= isSelf ? 'disabled' : '' %>>
                            <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                            <option value="manager" <%= u.role === 'manager' ? 'selected' : '' %>>Manager</option>
                            <option value="engineer" <%= u.role === 'engineer' ? 'selected' : '' %>>Engineer</option>
                          </select>
                          <button type="submit" class="btn btn-sm btn-outline-primary" <%= isSelf ? 'disabled' : '' %>>Update</button>
                        </form>
                        <form action="/admin/users/<%= u._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this user?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger" <%= isSelf ? 'disabled' : '' %> title="Delete User">
                            <i class="bi bi-trash"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="5" class="text-center py-5 text-muted">No users found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>
<%- include('../layouts/_footer') %>
