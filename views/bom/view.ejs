<%- include('../layouts/_header') %>
<div class="d-flex">
  <%- include('../layouts/_sidebar') %>
  <div class="main-content flex-grow-1">
    <div class="p-4">
      <%- include('../layouts/_alert') %>
      
      <!-- Header row -->
      <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div class="d-flex align-items-center gap-2">
          <h2 class="mb-0 fw-bold"><%= locals.product.name %></h2>
          <span class="badge bg-light text-dark border fs-6">v<%= locals.product.version %></span>
          <% 
            let statusClass = 'success';
            if (locals.product.status === 'Discontinued') statusClass = 'danger';
            if (locals.product.status === 'In Review') statusClass = 'warning text-dark';
          %>
          <span class="badge bg-<%= statusClass %> fs-6"><%= locals.product.status %></span>
        </div>
        <div class="d-flex gap-2">
          <a href="/bom" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to BOM List
          </a>
          <a href="/pdf/bom/<%= locals.product._id %>" class="btn btn-primary">
            <i class="bi bi-file-earmark-pdf"></i> Download PDF
          </a>
        </div>
      </div>

      <!-- Info summary (4 small boxes) -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="card bg-white border-0 shadow-sm h-100">
            <div class="card-body py-3 text-center">
              <h6 class="text-muted text-uppercase small fw-bold mb-1">Category</h6>
              <div class="fw-medium fs-5"><%= locals.product.category %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-white border-0 shadow-sm h-100">
            <div class="card-body py-3 text-center">
              <h6 class="text-muted text-uppercase small fw-bold mb-1">Version</h6>
              <div class="fw-medium fs-5"><%= locals.product.version %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-white border-0 shadow-sm h-100 border-start border-primary" style="border-left-width: 4px !important;">
            <div class="card-body py-3 text-center">
              <h6 class="text-muted text-uppercase small fw-bold mb-1">Total Components</h6>
              <div class="fw-bold fs-4 text-primary"><%= locals.product.components.length %></div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-white border-0 shadow-sm h-100">
            <div class="card-body py-3 text-center">
              <h6 class="text-muted text-uppercase small fw-bold mb-1">Status</h6>
              <div class="fw-medium fs-5 text-<%= statusClass === 'warning text-dark' ? 'warning' : statusClass %>"><%= locals.product.status %></div>
            </div>
          </div>
        </div>
      </div>

      <!-- BOM table -->
      <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom py-3">
          <h5 class="mb-0 fw-bold">Bill of Materials</h5>
        </div>
        <div class="card-body p-0 table-responsive">
          <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="px-4">#</th>
                <th>Part Number</th>
                <th>Component Name</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Material</th>
                <th>Specifications</th>
              </tr>
            </thead>
            <tbody>
              <% if (locals.product.components && locals.product.components.length > 0) { %>
                <% locals.product.components.forEach((comp, index) => { %>
                  <tr>
                    <td class="px-4 text-muted"><%= index + 1 %></td>
                    <td class="font-monospace text-secondary"><%= comp.partNumber || '-' %></td>
                    <td class="fw-medium"><%= comp.name %></td>
                    <td class="fw-bold"><%= comp.quantity %></td>
                    <td class="text-muted"><%= comp.unit %></td>
                    <td><%= comp.material || '-' %></td>
                    <td><span class="text-truncate d-inline-block" style="max-width: 250px;" title="<%= comp.specifications %>"><%= comp.specifications || '-' %></span></td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    No components in BOM yet.
                  </td>
                </tr>
              <% } %>
            </tbody>
            <% if (locals.product.components && locals.product.components.length > 0) { %>
              <tfoot class="table-light border-top border-2">
                <tr>
                  <td colspan="3" class="px-4 text-end fw-bold">Total Items:</td>
                  <td colspan="4" class="fw-bold fs-5 text-primary"><%= locals.product.components.length %></td>
                </tr>
              </tfoot>
            <% } %>
          </table>
        </div>
      </div>

      <% if (locals.product.description) { %>
        <!-- Product description card -->
        <div class="card shadow-sm border-0 bg-light mt-4">
          <div class="card-body p-4">
            <h6 class="text-muted text-uppercase small fw-bold mb-2">Product Description</h6>
            <p class="mb-0"><%= locals.product.description %></p>
          </div>
        </div>
      <% } %>

    </div>
  </div>
</div>
<%- include('../layouts/_footer') %>
