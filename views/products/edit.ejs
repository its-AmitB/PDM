<%- include('../layouts/_header') %>
<div class="d-flex">
  <%- include('../layouts/_sidebar') %>
  <div class="main-content flex-grow-1">
    <div class="p-4 mx-auto" style="max-width: 800px;">
      <%- include('../layouts/_alert') %>
      
      <div class="mb-4 d-flex align-items-center">
        <a href="/products/<%= locals.product._id %>" class="btn btn-outline-secondary btn-sm me-3">
          <i class="bi bi-arrow-left"></i> Back to Product
        </a>
        <h2 class="mb-0 fw-bold">Edit Product</h2>
      </div>

      <div class="card shadow-sm border-0">
        <div class="card-body p-4">
          <form action="/products/<%= locals.product._id %>?_method=PUT" method="POST">
            <div class="row g-4">
              
              <div class="col-md-8">
                <label for="name" class="form-label fw-bold small text-muted">Product Name <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="name" name="name" required value="<%= locals.product.name %>">
              </div>
              
              <div class="col-md-4">
                <label for="version" class="form-label fw-bold small text-muted">Version <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="version" name="version" required placeholder="e.g. 1.0, 2.1" value="<%= locals.product.version %>">
              </div>
              
              <div class="col-md-6">
                <label for="category" class="form-label fw-bold small text-muted">Category <span class="text-danger">*</span></label>
                <select class="form-select" id="category" name="category" required>
                  <% const categories = ['Mechanical', 'Electrical', 'Software', 'Assembly', 'Document', 'Other']; %>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat %>" <%= locals.product.category === cat ? 'selected' : '' %>><%= cat %></option>
                  <% }) %>
                </select>
              </div>
              
              <div class="col-md-6">
                <label for="status" class="form-label fw-bold small text-muted">Status</label>
                <select class="form-select" id="status" name="status">
                  <% const statuses = ['Active', 'In Review', 'Discontinued']; %>
                  <% statuses.forEach(stat => { %>
                    <option value="<%= stat %>" <%= locals.product.status === stat ? 'selected' : '' %>><%= stat %></option>
                  <% }) %>
                </select>
              </div>
              
              <div class="col-12">
                <label for="description" class="form-label fw-bold small text-muted">Description</label>
                <textarea class="form-control" id="description" name="description" rows="4"><%= locals.product.description %></textarea>
              </div>
              
            </div>
            
            <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
              <a href="/products/<%= locals.product._id %>" class="btn btn-outline-secondary">Cancel</a>
              <button type="submit" class="btn btn-primary">Update Product</button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </div>
</div>
<%- include('../layouts/_footer') %>
