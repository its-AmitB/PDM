<%- include('../layouts/_header') %>
<div class="d-flex">
  <%- include('../layouts/_sidebar') %>
  <div class="main-content flex-grow-1">
    <div class="p-4">
      <%- include('../layouts/_alert') %>
      
      <!-- Top header with Back button -->
      <div class="mb-4 d-flex align-items-center">
        <a href="/products" class="btn btn-outline-secondary btn-sm me-3">
          <i class="bi bi-arrow-left"></i> Back to Products
        </a>
        <h2 class="mb-0 fw-bold">Product Details</h2>
      </div>

      <div class="row g-4">
        <!-- LEFT COLUMN -->
        <div class="col-lg-8">
          
          <!-- Product Info Card -->
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-2">
                <h4 class="mb-0 fw-bold"><%= locals.product.name %></h4>
                <span class="badge bg-light text-dark border fs-6">v<%= locals.product.version %></span>
                <% 
                  let statusClass = 'success';
                  if (locals.product.status === 'Discontinued') statusClass = 'danger';
                  if (locals.product.status === 'In Review') statusClass = 'warning text-dark';
                %>
                <span class="badge bg-<%= statusClass %>"><%= locals.product.status %></span>
              </div>
            </div>
            <div class="card-body">
              <h6 class="text-muted text-uppercase small fw-bold mb-2">Description</h6>
              <p class="mb-4"><%= locals.product.description || 'No description provided.' %></p>
              
              <div class="row g-3">
                <div class="col-sm-6">
                  <h6 class="text-muted text-uppercase small fw-bold mb-1">Category</h6>
                  <p class="mb-0 fw-medium"><%= locals.product.category %></p>
                </div>
                <div class="col-sm-6">
                  <h6 class="text-muted text-uppercase small fw-bold mb-1">Created By</h6>
                  <p class="mb-0 fw-medium"><%= locals.product.createdBy ? locals.product.createdBy.name : 'Unknown' %></p>
                </div>
              </div>
            </div>
            <div class="card-footer bg-light py-3 d-flex gap-2 flex-wrap">
              <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                <a href="/products/<%= locals.product._id %>/edit" class="btn btn-primary btn-sm">
                  <i class="bi bi-pencil"></i> Edit
                </a>
              <% } %>
              <% if (locals.user && locals.user.role === 'admin') { %>
                <form action="/products/<%= locals.product._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product AND all its components?');">
                  <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              <% } %>
              <a href="/pdf/bom/<%= locals.product._id %>" class="btn btn-outline-secondary btn-sm ms-auto">
                <i class="bi bi-file-earmark-pdf"></i> Download Spec PDF
              </a>
              <a href="/bom/<%= locals.product._id %>" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-list-nested"></i> View BOM
              </a>
            </div>
          </div>

          <!-- Components Section -->
          <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
              <h5 class="mb-0 fw-bold">
                Bill of Materials 
                <span class="badge bg-secondary ms-2"><%= locals.product.components.length %></span>
              </h5>
              <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                <button class="btn btn-sm btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#addComponentForm">
                  <i class="bi bi-plus-circle"></i> Add Component
                </button>
              <% } %>
            </div>
            
            <div class="card-body p-0">
              <!-- Add Component Form (Collapsible) -->
              <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                <div class="collapse bg-light border-bottom" id="addComponentForm">
                  <form action="/products/<%= locals.product._id %>/components" method="POST" class="p-4">
                    <h6 class="fw-bold mb-3">Add New Component</h6>
                    <div class="row g-3">
                      <div class="col-md-6">
                        <label class="form-label small fw-bold">Name *</label>
                        <input type="text" name="name" class="form-control form-control-sm" required>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label small fw-bold">Part Number</label>
                        <input type="text" name="partNumber" class="form-control form-control-sm">
                      </div>
                      <div class="col-md-3">
                        <label class="form-label small fw-bold">Quantity *</label>
                        <input type="number" name="quantity" class="form-control form-control-sm" min="1" value="1" required>
                      </div>
                      <div class="col-md-3">
                        <label class="form-label small fw-bold">Unit *</label>
                        <select name="unit" class="form-select form-select-sm" required>
                          <option value="pcs">pcs</option>
                          <option value="kg">kg</option>
                          <option value="g">g</option>
                          <option value="L">L</option>
                          <option value="m">m</option>
                          <option value="cm">cm</option>
                          <option value="set">set</option>
                        </select>
                      </div>
                      <div class="col-md-6">
                        <label class="form-label small fw-bold">Material</label>
                        <input type="text" name="material" class="form-control form-control-sm">
                      </div>
                      <div class="col-12">
                        <label class="form-label small fw-bold">Specifications</label>
                        <input type="text" name="specifications" class="form-control form-control-sm">
                      </div>
                      <div class="col-12 text-end mt-3">
                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" data-bs-toggle="collapse" data-bs-target="#addComponentForm">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary">Save Component</button>
                      </div>
                    </div>
                  </form>
                </div>
              <% } %>

              <!-- Components Table -->
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th class="px-4">Part #</th>
                      <th>Name</th>
                      <th>Qty + Unit</th>
                      <th>Material</th>
                      <th>Specs</th>
                      <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                        <th class="text-end px-4">Actions</th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (locals.product.components && locals.product.components.length > 0) { %>
                      <% locals.product.components.forEach(comp => { %>
                        <tr>
                          <td class="px-4 text-muted"><%= comp.partNumber || '-' %></td>
                          <td class="fw-medium"><%= comp.name %></td>
                          <td><%= comp.quantity %> <%= comp.unit %></td>
                          <td><%= comp.material || '-' %></td>
                          <td><span class="text-truncate d-inline-block" style="max-width: 150px;" title="<%= comp.specifications %>"><%= comp.specifications || '-' %></span></td>
                          <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                            <td class="text-end px-4">
                              <form action="/products/<%= locals.product._id %>/components/<%= comp._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Remove this component?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Component">
                                  <i class="bi bi-x-circle"></i>
                                </button>
                              </form>
                            </td>
                          <% } %>
                        </tr>
                      <% }) %>
                    <% } else { %>
                      <tr>
                        <td colspan="<%= (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) ? '6' : '5' %>" class="text-center py-4 text-muted">
                          No components added yet.
                        </td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-lg-4">
          
          <!-- Metadata Card -->
          <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom py-3">
              <h6 class="mb-0 fw-bold">Metadata</h6>
            </div>
            <div class="card-body p-0">
              <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Product ID</span>
                  <span class="font-monospace text-secondary small text-truncate" style="max-width: 150px;" title="<%= locals.product._id %>"><%= locals.product._id %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Version</span>
                  <span class="badge bg-light text-dark border"><%= locals.product.version %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Category</span>
                  <span class="fw-medium"><%= locals.product.category %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Status</span>
                  <% 
                    let stClass = 'success';
                    if (locals.product.status === 'Discontinued') stClass = 'danger';
                    if (locals.product.status === 'In Review') stClass = 'warning text-dark';
                  %>
                  <span class="badge bg-<%= stClass %>"><%= locals.product.status %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Created At</span>
                  <span class="small"><%= locals.product.createdAt.toLocaleDateString() %></span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                  <span class="text-muted small fw-bold text-uppercase">Last Updated</span>
                  <span class="small"><%= locals.product.updatedAt.toLocaleDateString() %></span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Quick Actions Card -->
          <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
              <h6 class="mb-0 fw-bold">Quick Actions</h6>
            </div>
            <div class="card-body d-flex flex-column gap-2">
              <% if (locals.user && (locals.user.role === 'manager' || locals.user.role === 'admin')) { %>
                <a href="/products/<%= locals.product._id %>/edit" class="btn btn-outline-primary d-flex justify-content-between align-items-center p-3 text-start">
                  <span><i class="bi bi-pencil me-2"></i> Edit Product</span>
                  <i class="bi bi-chevron-right"></i>
                </a>
              <% } %>
              <a href="/pdf/bom/<%= locals.product._id %>" class="btn btn-outline-secondary d-flex justify-content-between align-items-center p-3 text-start">
                <span><i class="bi bi-file-earmark-pdf me-2"></i> Generate BOM PDF</span>
                <i class="bi bi-chevron-right"></i>
              </a>
              <a href="/bom/<%= locals.product._id %>" class="btn btn-outline-secondary d-flex justify-content-between align-items-center p-3 text-start">
                <span><i class="bi bi-list-nested me-2"></i> View BOM</span>
                <i class="bi bi-chevron-right"></i>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
<%- include('../layouts/_footer') %>
